# --- backend-node/.env.docker ---
#NODE_ENV=production

# Порт СЕРВЕРА внутри контейнера
PORT=8080
# Порт на ХОСТЕ (куда ходить из браузера/Postman)
HOST_PORT=8080

# Путь данных внутри контейнера (не трогаем)
DATA_DIR=/app/data

# DEV: разрешить тесты без Telegram initData (Postman/curl с x-dev-user)
DEV_ALLOW_ANON=1

# CORS — домены, с которых можно дергать API
ORIGIN_ALLOWED=http://localhost:5173,https://localhost

# Для QR deeplink (t.me/<bot>?startapp=...)
PUBLIC_BOT_USERNAME=your_bot_name_here

# Для боевой проверки Telegram initData — в DEV можно оставить пустым
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# INITDATA_MAX_AGE_SEC=86400